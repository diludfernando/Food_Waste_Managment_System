// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  RECIPIENT
  VOLUNTEER
  ADMIN
}

enum Status {
  AVAILABLE
  RESERVED
  COMPLETED
  EXPIRED
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password          String
  role              Role       @default(DONOR)
  donatedFoodItems  FoodItem[] @relation("DonorFoodItems")
  claimedFoodItems  FoodItem[] @relation("CharityFoodItems")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("users")
}

model FoodItem {
  id          String    @id @default(uuid())
  title       String
  donorName   String    @default("Anonymous Donor")
  dietary     String    @default("Veg") // "Veg" | "Non-Veg"
  isHalal     Boolean   @default(false)
  portions    Int       @default(1)
  weight      String?   // e.g. "14.0 kg"
  expiryTime  DateTime
  address     String
  city        String    @default("Colombo")
  contact     String
  status      Status    @default(AVAILABLE)

  donorId     String?
  donor       User?     @relation("DonorFoodItems", fields: [donorId], references: [id], onDelete: SetNull)

  claimedById String?
  claimedBy   User?     @relation("CharityFoodItems", fields: [claimedById], references: [id], onDelete: SetNull)

  reservedAt  DateTime?
  completedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("food_items")
}
